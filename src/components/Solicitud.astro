---
import { cliente } from '../config/cliente';
import { enlaceTelefono } from '../lib/contacto';
import Icono from './ui/Icono.astro';

const { solicitud, contacto } = cliente;
---

<section id="solicitud" class="solicitud bloque">
  <div class="wrap rejilla">
    <div>
      <h2>{solicitud.titulo}</h2>
      {solicitud.descripcion && <p class="intro">{solicitud.descripcion}</p>}
      <p class="llamar">
        {solicitud.nota} <a href={enlaceTelefono}>{contacto.telefonoVisible}</a>.
      </p>
    </div>
    <form id="form-solicitud" data-whatsapp={contacto.whatsapp} novalidate>
      <fieldset class="urgencia">
        <legend>¿Para cuándo?</legend>
        <label><input type="radio" name="urgencia" value="Urgente, ahora mismo" checked /> Ahora mismo</label>
        <label><input type="radio" name="urgencia" value="Para agendar" /> Para otro día</label>
      </fieldset>
      <label for="solicitud-servicio">
        Servicio
        <select id="solicitud-servicio" name="servicio">
          {solicitud.servicios.map((servicio) => <option>{servicio}</option>)}
        </select>
      </label>
      <label for="solicitud-zona">
        Zona
        <input
          id="solicitud-zona"
          type="text"
          name="zona"
          placeholder={solicitud.ejemploZona}
          autocomplete="address-level2"
        />
      </label>
      <label for="solicitud-detalles" class="completo">
        Detalles (opcional)
        <textarea id="solicitud-detalles" name="detalles" rows="3" placeholder={solicitud.ejemploDetalles}></textarea>
      </label>
      <div class="ubicacion">
        <button type="button" class="btn btn-linea" id="btn-ubicacion">
          <Icono nombre="ubicacion" tamano={18} />
          Compartir mi ubicación
        </button>
        <span class="estado" id="estado-ubicacion" aria-live="polite">Opcional. Nos ayuda a llegar más rápido.</span>
      </div>
      <button type="submit" class="btn btn-naranja enviar">{solicitud.boton}</button>
      <p id="wa-listo" class="estado completo" hidden>
        Si WhatsApp no se abrió, <a id="wa-enlace" href="#" target="_blank" rel="noopener">toca aquí para enviar tu solicitud</a>.
      </p>
    </form>
  </div>
</section>

<script>
  // El formulario arma el mensaje y abre WhatsApp. No se envía nada a ningún servidor.
  const formulario = document.getElementById('form-solicitud') as HTMLFormElement | null;
  const estado = document.getElementById('estado-ubicacion');
  const botonUbicacion = document.getElementById('btn-ubicacion');
  let ubicacion = '';

  botonUbicacion?.addEventListener('click', () => {
    if (!estado) return;
    if (!('geolocation' in navigator)) {
      estado.textContent = 'Este navegador no comparte ubicación. Escribe tu zona.';
      return;
    }
    estado.textContent = 'Buscando tu ubicación…';
    navigator.geolocation.getCurrentPosition(
      (posicion) => {
        const { latitude, longitude } = posicion.coords;
        ubicacion = `https://maps.google.com/?q=${latitude.toFixed(6)},${longitude.toFixed(6)}`;
        estado.textContent = 'Ubicación lista. Se enviará con tu mensaje.';
        estado.classList.add('lista');
      },
      () => {
        estado.textContent = 'No se pudo obtener la ubicación. Escribe tu zona.';
      },
      { enableHighAccuracy: true, timeout: 10000 },
    );
  });

  formulario?.addEventListener('submit', (evento) => {
    evento.preventDefault();
    const datos = new FormData(formulario);
    const lineas = [
      'Hola, quiero pedir un cerrajero.',
      `Para: ${datos.get('urgencia')}`,
      `Servicio: ${datos.get('servicio')}`,
      `Zona: ${datos.get('zona') || 'sin indicar'}`,
    ];
    const detalles = String(datos.get('detalles') ?? '').trim();
    if (detalles) lineas.push(`Detalles: ${detalles}`);
    if (ubicacion) lineas.push(`Mi ubicación: ${ubicacion}`);

    const numero = formulario.dataset.whatsapp ?? '';
    const url = `https://wa.me/${numero}?text=${encodeURIComponent(lineas.join('\n'))}`;

    // Enlace de respaldo por si el navegador bloquea la ventana nueva.
    const enlace = document.getElementById('wa-enlace') as HTMLAnchorElement | null;
    if (enlace) enlace.href = url;
    document.getElementById('wa-listo')?.removeAttribute('hidden');
    window.open(url, '_blank', 'noopener');
  });
</script>

<style>
  .solicitud {
    background: var(--silueta);
  }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px;
  }
  h2 {
    color: var(--atardecer);
  }
  .llamar {
    color: var(--papel-3);
    font-size: 15px;
    margin: 0;
  }
  .llamar a {
    color: var(--atardecer);
    font-weight: 800;
  }
  form {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    min-width: 0;
  }
  label {
    flex: 1 1 220px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    color: var(--papel-2);
    font-weight: 600;
  }
  .completo {
    flex-basis: 100%;
  }
  input,
  select,
  textarea {
    background: #141414;
    border: 2px solid #2f2f2f;
    border-radius: 12px;
    padding: 14px;
    color: var(--papel);
    font-size: 16px;
    min-height: 52px;
    font-family: inherit;
    width: 100%;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--atardecer);
  }
  .urgencia {
    flex-basis: 100%;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    border: 0;
    padding: 0;
    margin: 0;
  }
  legend {
    font-size: 15px;
    color: var(--papel-2);
    font-weight: 600;
    margin-bottom: 8px;
    padding: 0;
  }
  .urgencia label {
    flex: 1 1 160px;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    background: #141414;
    border: 2px solid #2f2f2f;
    border-radius: 12px;
    padding: 14px;
    cursor: pointer;
    color: var(--papel);
    font-size: 16px;
    min-height: 54px;
  }
  .urgencia input {
    width: auto;
    min-height: auto;
    accent-color: var(--atardecer);
  }
  .urgencia label:has(input:checked) {
    border-color: var(--atardecer);
    background: #1b1408;
  }
  .ubicacion {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ubicacion .btn {
    color: var(--papel);
    min-height: 48px;
    font-size: 15px;
  }
  .estado {
    font-size: 14px;
    color: var(--papel-3);
    margin: 0;
  }
  .estado.lista {
    color: var(--atardecer);
  }
  .estado a {
    color: var(--atardecer);
    font-weight: 800;
  }
  .enviar {
    flex-basis: 100%;
    font-size: 18px;
    min-height: 58px;
  }
</style>
