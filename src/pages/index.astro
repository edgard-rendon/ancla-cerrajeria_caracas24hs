---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Casos from '../components/Casos.astro';
import Servicios from '../components/Servicios.astro';
import Pasos from '../components/Pasos.astro';
import Zonas from '../components/Zonas.astro';
import Trabajos from '../components/Trabajos.astro';
import Tienda from '../components/Tienda.astro';
import Testimonios from '../components/Testimonios.astro';
import Solicitud from '../components/Solicitud.astro';
import Footer from '../components/Footer.astro';
import BarraMovil from '../components/BarraMovil.astro';
---

<Base>
  <Navbar />
  <main id="contenido-principal">
    <Hero />
    <Casos />
    <Servicios />
    <Pasos />
    <Zonas />
    <Trabajos />
    <Tienda />
    <Testimonios />
    <Solicitud />
  </main>
  <Footer />
  <BarraMovil />
</Base>
