<style>
  .escena {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ventana {
      animation: enciende 0.6s ease-out both;
    }
  }
  @keyframes enciende {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
