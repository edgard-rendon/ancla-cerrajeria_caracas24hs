---
/**
 * Objetos que flotan en el cielo, como en el mural de la tienda: el Codiplug,
 * una llave de carro y tres llaves de contacto (de ascensor).
 * Van en dibujos aparte para que no crezcan en pantallas anchas:
 * - `.flotantes` mide lo mismo que el contenido (hasta 1180 px) y va centrado.
 * - `.flotantes-der` va pegado al borde derecho de la pantalla.
 * En el teléfono se ocultan porque caerían encima del texto.
 */
---

<div class="flotantes" aria-hidden="true">
<svg viewBox="0 0 1180 640" preserveAspectRatio="xMidYMin meet">
<!-- Flotando, como en el mural: tres llaves de ascensor (iButton: disco metálico más ancho que el cuerpo y cola inclinada), un Codiplug y una llave de carro -->
<!-- Codiplug: cuerpo negro de tres niveles, botón amarillo y negro, y la luz roja que titila al presionar -->
<g class="flota d"><g transform="translate(722 552) rotate(-10)">
<circle cx="-20" cy="-24" r="14" fill="none" stroke="#D9D9D9" stroke-width="4"/>
<circle cx="-4" cy="-14" r="4" fill="none" stroke="#D9D9D9" stroke-width="2.5"/>
<circle cx="6" cy="-10" r="4" fill="none" stroke="#D9D9D9" stroke-width="2.5"/>
<circle cx="16" cy="-6" r="4" fill="none" stroke="#D9D9D9" stroke-width="2.5"/>
<rect x="24" y="-10" width="24" height="16" rx="6" fill="#1d1d1d"/>
<circle cx="36" cy="-3" r="3.5" fill="#FF8A1E"/>
<rect x="0" y="0" width="72" height="86" rx="9" fill="#1a1a1a"/>
<rect x="2" y="10" width="3" height="66" rx="1.5" fill="#2a2a2a"/><rect x="67" y="10" width="3" height="66" rx="1.5" fill="#2a2a2a"/>
<rect x="8" y="7" width="56" height="15" rx="3" fill="#262626"/>
<rect x="8" y="27" width="56" height="30" rx="4" fill="#303030"/>
<circle class="cp-boton" cx="19" cy="42" r="8" fill="#E8D33A"/>
<path d="M29 52 L35 32" stroke="#8A8A8A" stroke-width="3" stroke-linecap="round"/>
<circle cx="44" cy="42" r="8" fill="#0D0D0D" stroke="#454545" stroke-width="1.5"/>
<circle class="cp-brillo" cx="58" cy="42" r="6.5" fill="#FF3B30" opacity="0"/>
<circle class="cp-led" cx="58" cy="42" r="3" fill="#5A1010"/>
<rect x="8" y="62" width="56" height="17" rx="3" fill="#262626"/>
<rect x="18" y="67.5" width="36" height="6" rx="2" fill="#4A4A4A"/>
</g></g>
<!-- llave de carro -->
<g class="flota e"><g transform="translate(1046 360) rotate(-28)">
<rect x="0" y="0" width="40" height="66" rx="14" fill="#111"/>
<circle cx="20" cy="16" r="6" fill="#444"/><circle cx="20" cy="33" r="6" fill="#444"/><circle cx="20" cy="50" r="5" fill="#D7263D"/>
<path d="M14 66 H27 V118 L23 124 H14 V112 L18 108 L14 104 V96 L18 92 L14 88 V80 L18 76 L14 72Z" fill="#CFCFCF"/>
</g></g>
</svg>
</div>
<!-- Llaves de ascensor, pegadas al borde derecho de la pantalla -->
<div class="flotantes-der" aria-hidden="true">
<svg viewBox="0 0 200 130">
<g class="flota "><g transform="translate(6 24) rotate(-16)">
<g transform="scale(.86)">
<g transform="rotate(8 20 20)"><rect x="3" y="18" width="34" height="108" rx="17" fill="#D7263D"/><rect x="9" y="48" width="22" height="44" rx="3" fill="#000" opacity=".18"/><circle cx="20" cy="109" r="7" fill="#FF8A1E"/></g>
<circle cx="20" cy="20" r="21" fill="#D7263D"/>
<circle cx="20" cy="20" r="18" fill="#8E959B"/><circle cx="20" cy="20" r="15.5" fill="#D3D7DA"/><circle cx="20" cy="20" r="11.5" fill="#AEB4B9"/><path d="M12 16 A9 9 0 0 1 19 11" stroke="#EEF1F3" stroke-width="2" fill="none" stroke-linecap="round"/>
</g>
</g></g>
<g class="flota b"><g transform="translate(78 8) rotate(0)">
<g transform="scale(.86)">
<g transform="rotate(8 20 20)"><rect x="3" y="18" width="34" height="108" rx="17" fill="#111"/><rect x="9" y="48" width="22" height="44" rx="3" fill="#FFFFFF" opacity=".1"/><circle cx="20" cy="109" r="7" fill="#FF8A1E"/></g>
<circle cx="20" cy="20" r="21" fill="#111"/>
<circle cx="20" cy="20" r="18" fill="#8E959B"/><circle cx="20" cy="20" r="15.5" fill="#D3D7DA"/><circle cx="20" cy="20" r="11.5" fill="#AEB4B9"/><path d="M12 16 A9 9 0 0 1 19 11" stroke="#EEF1F3" stroke-width="2" fill="none" stroke-linecap="round"/>
</g>
</g></g>
<g class="flota c"><g transform="translate(148 16) rotate(16)">
<g transform="scale(.86)">
<g transform="rotate(8 20 20)"><rect x="3" y="18" width="34" height="108" rx="17" fill="#1D4ED8"/><rect x="9" y="48" width="22" height="44" rx="3" fill="#000" opacity=".18"/><circle cx="20" cy="109" r="7" fill="#FF8A1E"/></g>
<circle cx="20" cy="20" r="21" fill="#1D4ED8"/>
<circle cx="20" cy="20" r="18" fill="#8E959B"/><circle cx="20" cy="20" r="15.5" fill="#D3D7DA"/><circle cx="20" cy="20" r="11.5" fill="#AEB4B9"/><path d="M12 16 A9 9 0 0 1 19 11" stroke="#EEF1F3" stroke-width="2" fill="none" stroke-linecap="round"/>
</g>
</g></g>
</svg>
</div>

<style>
  .flotantes {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 1180px);
    z-index: 1;
    pointer-events: none;
  }
  .flotantes-der {
    position: absolute;
    top: 572px;
    right: max(24px, 2vw);
    width: 200px;
    z-index: 1;
    pointer-events: none;
  }
  .flotantes svg,
  .flotantes-der svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  @media (max-width: 760px) {
    .flotantes,
    .flotantes-der {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .flota {
      animation: flota 6s ease-in-out infinite;
    }
    .flota.b {
      animation-duration: 7.5s;
      animation-delay: -2s;
    }
    .flota.c {
      animation-duration: 8.5s;
      animation-delay: -4s;
    }
    .flota.d {
      animation-duration: 9s;
      animation-delay: -1s;
    }
    .flota.e {
      animation-duration: 6.8s;
      animation-delay: -3s;
    }
    /* Codiplug: se hunde el botón amarillo y titila la luz roja. */
    .cp-boton {
      transform-box: fill-box;
      transform-origin: center;
      animation: pulsa 3.6s ease-in-out infinite;
    }
    .cp-led {
      animation: led 3.6s linear infinite;
    }
    .cp-brillo {
      animation: brillo 3.6s linear infinite;
    }
  }
  @keyframes flota {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }
  @keyframes pulsa {
    0%,
    8%,
    100% {
      transform: scale(1);
      fill: #e8d33a;
    }
    3% {
      transform: scale(0.8);
      fill: #b9a520;
    }
  }
  @keyframes led {
    0%,
    2% {
      fill: #5a1010;
    }
    3%,
    6% {
      fill: #ff3b30;
    }
    7%,
    9% {
      fill: #5a1010;
    }
    10%,
    13% {
      fill: #ff3b30;
    }
    14%,
    100% {
      fill: #5a1010;
    }
  }
  @keyframes brillo {
    0%,
    2% {
      opacity: 0;
    }
    3%,
    6% {
      opacity: 0.55;
    }
    7%,
    9% {
      opacity: 0;
    }
    10%,
    13% {
      opacity: 0.55;
    }
    14%,
    100% {
      opacity: 0;
    }
  }
</style>
