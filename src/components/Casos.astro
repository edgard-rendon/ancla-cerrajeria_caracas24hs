---
import { cliente } from '../config/cliente';
import { enlaceWhatsApp } from '../lib/contacto';
import Icono from './ui/Icono.astro';

const { casos } = cliente;
---

<section class="casos" aria-labelledby="casos-titulo">
  <div class="wrap">
    <h2 id="casos-titulo">{casos.titulo}</h2>
    {casos.descripcion && <p class="sub">{casos.descripcion}</p>}
    <div class="chips">
      {
        casos.items.map((caso) => (
          <a class="chip" href={enlaceWhatsApp(caso.mensaje)} target="_blank" rel="noopener">
            <span class="ico">
              <Icono nombre={caso.icono} trazo={2.2} color="#000" />
            </span>
            <span>
              {caso.titulo}
              <small>{caso.detalle}</small>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .casos {
    background: var(--silueta);
    padding: 8px 0 64px;
  }
  h2 {
    color: var(--atardecer);
    font-size: clamp(34px, 4vw, 48px);
    max-width: none;
    margin: 0 0 8px;
  }
  .sub {
    margin: 0 0 24px;
    color: var(--papel-2);
  }
  .chips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }
  .chip {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    background: #141414;
    border: 1px solid #2b2b2b;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 700;
    min-height: 76px;
  }
  .chip:hover {
    border-color: var(--atardecer);
    background: #1b1408;
  }
  .ico {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--atardecer);
    display: grid;
    place-items: center;
    flex: none;
  }
  small {
    display: block;
    font-weight: 500;
    color: var(--papel-3);
    font-size: 14px;
    margin-top: 2px;
  }
</style>
