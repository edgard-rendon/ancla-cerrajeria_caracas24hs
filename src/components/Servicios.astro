---
import { cliente } from '../config/cliente';
import Icono from './ui/Icono.astro';

const { servicios } = cliente;
---

<section id="servicios" class="bloque">
  <div class="wrap">
    <h2>{servicios.titulo}</h2>
    {servicios.descripcion && <p class="intro">{servicios.descripcion}</p>}
    <div class="grupos">
      {
        servicios.grupos.map((grupo) => (
          <article class="grupo">
            <div class="cabecera">
              <Icono nombre={grupo.icono} tamano={40} trazo={1.8} color="var(--atardecer)" />
              <h3>{grupo.titulo}</h3>
            </div>
            <ul class="lista">
              {grupo.items.map((item) => (
                <li>
                  <span>{item.nombre}</span>
                  <span>{item.nota}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grupos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 20px;
  }
  .grupo {
    background: var(--noche-2);
    border-radius: 20px;
    padding: 30px 30px 18px;
    position: relative;
    overflow: hidden;
  }
  /* Un pequeño sol en la esquina de cada tarjeta. */
  .grupo::after {
    content: '';
    position: absolute;
    right: -30px;
    top: -30px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--atardecer);
    opacity: 0.14;
  }
  .cabecera {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }
  h3 {
    font-size: 34px;
  }
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lista li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--noche-3);
  }
  .lista li span:first-child {
    font-weight: 600;
  }
  .lista li span:last-child {
    color: var(--papel-3);
    font-size: 15px;
    white-space: nowrap;
  }
</style>
