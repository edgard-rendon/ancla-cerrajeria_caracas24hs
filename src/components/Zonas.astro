---
import { cliente } from '../config/cliente';
import Cresta from './ui/Cresta.astro';

const { zonas } = cliente;
---

<Cresta color="var(--noche-2)" />
<section id="zonas" class="zonas">
  <div class="wrap rejilla">
    <div>
      <h2>{zonas.titulo}</h2>
      {zonas.descripcion && <p class="intro">{zonas.descripcion}</p>}
    </div>
    <div>
      <ul class="municipios">
        {
          zonas.items.map((zona) => (
            <li class:list={['municipio', { base: zona.base }]}>
              {zona.nombre}
              {zona.nota && ` (${zona.nota})`}
            </li>
          ))
        }
      </ul>
      {zonas.nota && <p class="nota">{zonas.nota}</p>}
    </div>
  </div>
</section>
<Cresta color="var(--noche-2)" invertida />

<style>
  .zonas {
    background: var(--noche-2);
    padding-block: 48px 88px;
  }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 40px;
    align-items: start;
  }
  .intro {
    margin-bottom: 0;
  }
  .municipios {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .municipio {
    border: 2px solid var(--noche-3);
    border-radius: 999px;
    padding: 10px 18px;
    font-weight: 700;
  }
  .municipio.base {
    border-color: var(--atardecer);
    color: var(--atardecer);
  }
  .nota {
    color: var(--papel-3);
    font-size: 15px;
    margin: 18px 0 0;
  }
</style>
