# Copia este archivo como .env para probar en tu computadora.
# En el hosting, configura las mismas variables en su panel.

# true = barra de "vista previa" y sin indexar en buscadores. Quítala (o false) al publicar la web oficial.
VISTA_PREVIA=true

# URL pública mientras no exista el dominio final. Vacía = usa la de src/config/cliente.ts.
SITE_URL=
