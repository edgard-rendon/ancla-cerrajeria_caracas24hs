<linearGradient id="g-sol" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFE26A"/><stop offset="1" stop-color="#FFC21F"/></linearGradient>
</defs>
<!-- Sol con el 24 -->
<g>
<circle cx="1080" cy="250" r="170" fill="url(#g-sol)"/>
<text x="1080" y="300" text-anchor="middle" font-family="Anton, Impact, sans-serif" font-size="170" fill="#E2470F" opacity=".9">24</text>
</g>

<!-- Hotel Humboldt en la cima: torre cilíndrica con pisos, corona, antena y el edificio bajo de techos curvos -->
